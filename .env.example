# =========================
# App / Mongo
# =========================
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=ai_sales_agent
STREAMLIT_APP_TITLE=AI Sales Agent Dashboard

# =========================
# Email sending
# =========================
EMAIL_SEND_MODE=gmail_draft
SENDGRID_ENABLED=true
SENDGRID_API_KEY=YOUR_SENDGRID_API_KEY
SENDGRID_FROM_EMAIL=your_sender_email@example.com

# Gmail draft sender identity
GMAIL_DRAFT_FROM_EMAIL=your_sender_email@example.com

# Customer auto-reply mailbox
AUTO_REPLY_CUSTOMER_EMAIL=customer_mailbox@example.com

# Gmail OAuth files (local paths)
GMAIL_OAUTH_CLIENT_SECRET_PATH=F:/WORK/sales_ai_agent/salesagent/gmail_client_secret.json
GMAIL_OAUTH_TOKEN_PATH=F:/WORK/sales_ai_agent/salesagent/gmail_token.json
GMAIL_LOOP_SENDER_TOKEN_PATH=F:/WORK/sales_ai_agent/salesagent/gmail_sender_loop_token.json
GMAIL_LOOP_CUSTOMER_TOKEN_PATH=F:/WORK/sales_ai_agent/salesagent/gmail_customer_token.json

# =========================
# Calendar / Scheduling
# =========================
SENDER_TIMEZONE=Asia/Kolkata
SENDER_LOOP_SCOPES=https://www.googleapis.com/auth/gmail.modify,https://www.googleapis.com/auth/gmail.compose,https://www.googleapis.com/auth/calendar.readonly,https://www.googleapis.com/auth/calendar.events
GOOGLE_CALENDAR_ID=primary
CALENDAR_LOOKAHEAD_DAYS=7
CALENDAR_WORKDAY_START_HOUR=9
CALENDAR_WORKDAY_END_HOUR=18
CALENDAR_MIN_SLOT_MINUTES=30

# =========================
# LLM
# =========================
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant

# =========================
# LocalXpose (optional)
# =========================
LOCALXPOSE_ACCESS_TOKEN=YOUR_LOCALXPOSE_TOKEN

# =========================
# Twilio SMS
# Use either TWILIO_FROM_NUMBER OR TWILIO_MESSAGING_SID
# =========================
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
TWILIO_MESSAGING_SID=YOUR_TWILIO_MESSAGING_SID
TWILIO_TO_NUMBER=+91XXXXXXXXXX
